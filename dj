[[ $# -lt 1 ]] && usage
cmd=$1; shift

case "$cmd" in
  extract-audio|ea)   cmd_extract_audio "$@" ;;
  replace-audio|ra)   cmd_replace_audio "$@" ;;
  compress-video|cv)  cmd_compress_video "$@" ;;
  -h|--help|help)     usage ;;
  *)                  echo "Неизвестная команда: $cmd" >&2; usage ;;
esac
